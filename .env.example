# Copy to .env and adjust. Every setting is GUARDRAIL_<FIELD> (see src/guardrail_proxy/config.py).

# Upstream model the application talks to (any OpenAI-compatible endpoint).
GUARDRAIL_UPSTREAM_BASE_URL=http://localhost:11434/v1
GUARDRAIL_UPSTREAM_API_KEY=ollama
GUARDRAIL_UPSTREAM_MODEL=llama3.2:3b

# Optional fallback upstream, tried if the primary fails.
# GUARDRAIL_FALLBACK_BASE_URL=https://api.openai.com/v1
# GUARDRAIL_FALLBACK_API_KEY=sk-...
# GUARDRAIL_FALLBACK_MODEL=gpt-4o-mini

# Judge for the hallucination check (keep it a different model family from the upstream).
GUARDRAIL_JUDGE_BASE_URL=http://localhost:11434/v1
GUARDRAIL_JUDGE_MODEL=qwen3.5:4b

# Policy file and audit log.
GUARDRAIL_POLICY_PATH=config/policy.yaml
GUARDRAIL_AUDIT_HMAC_KEY=change-me-to-a-long-random-string
